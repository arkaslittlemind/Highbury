# Local Postgres (docker compose up -d). Production uses Neon.
# Owner/admin URL: used only by migrations.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/highbury
# Ingest role: write access, used by ingest scripts only. Never deployed.
INGEST_DATABASE_URL=postgresql://ingest:ingest_local@localhost:5433/highbury
# Read-only role used by the analyst agent at runtime.
ANALYST_DATABASE_URL=postgresql://analyst_ro:analyst_ro_local@localhost:5433/highbury

# LLM (any init_chat_model "provider:model" string). The evals chose this model: see
# evals/results.md.
ANALYST_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The price of the model in US dollars for one million tokens. Set the two or
# none. With none, the request log has no cost.
ANALYST_INPUT_USD_PER_MTOK=0.75
ANALYST_OUTPUT_USD_PER_MTOK=3.75

# API
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=5
# Production only: the address range of the proxy in front of the API. uvicorn
# reads it, and takes the address of the visitor from X-Forwarded-For only when
# the connection comes from that range. Never "*": the visitor writes the first
# address of that header, and each new address gets a new rate-limit count.
# FORWARDED_ALLOW_IPS=

# Web (apps/web/.env.local, see apps/web/.env.example): NEXT_PUBLIC_API_URL
