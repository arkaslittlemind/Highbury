# Copy to .env.local. The origin of the analyst API, with no path and no slash
# at the end. It is public: Next.js puts it into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The site key of the Cloudflare Turnstile widget. It is public too. This value is
# Cloudflare's test key, which always passes; 3x00000000000000000000FF always shows
# the checkbox. With no key the page has no bot check, and the API refuses each
# question.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The footer visit count, from Cloudflare Web Analytics. Server-only: no
# NEXT_PUBLIC_ prefix, so Next.js never puts them into the bundle. The token needs
# Account Analytics Read and nothing more. The site tag is on the Web Analytics
# page of the site. With any of the three empty, the footer shows no count.
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SITE_TAG=
